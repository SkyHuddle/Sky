# PostgreSQL connection. If unset, the app uses an embedded PGlite database in .data/ (development only).
DATABASE_URL=postgres://lockin:lockin@127.0.0.1:5432/lockin

# 32+ random bytes, used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# Data provider. "demo" uses the clearly labelled synthetic dataset. Real adapters need credentials below.
DATA_PROVIDER=demo
PANDASCORE_API_TOKEN=
GRID_API_KEY=

# Enables the demo control panel (advance the demo tournament). Never enable in production.
DEMO_MODE=true
