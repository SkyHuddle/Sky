{
  "name": "lockin",
  "version": "0.1.0",
  "private": true,
  "description": "Lockin: CS2 tournament fantasy (independent project).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fontsource-variable/archivo": "5.3.0",
    "@radix-ui/react-dialog": "1.1.15",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.4",
    "geist": "1.7.2",
    "motion": "12.43.0",
    "next": "15.5.27",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "vaul": "1.1.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "postcss": "8.5.29",
    "tailwindcss": "4.1.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
